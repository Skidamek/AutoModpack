#!/usr/bin/env bash
set -euo pipefail

loader="${1:?loader required}"
minecraft="${2:?minecraft version required}"
host="${3:?server host required}"
port="${4:?server port required}"
java_version="${5:?java version required}"
loader_version="${6:-}"

game_dir="${AM_AUTOTEST_GAME_DIR:-/work/game}"
cache_dir="${AM_AUTOTEST_HMC_CACHE_DIR:-/work/hmc-cache}"
bridge_token="${AM_AUTOTEST_BRIDGE_TOKEN:?bridge token required}"
render_client="${AM_AUTOTEST_RENDER_CLIENT:-false}"
prepared_profile="${AM_AUTOTEST_HMC_PREPARED:-false}"
prepare_only="${AM_AUTOTEST_PREPARE_ONLY:-false}"
display_start_seconds="${AM_AUTOTEST_DISPLAY_START_SECONDS:-5}"

mkdir -p "$game_dir" "$cache_dir"

# ── Share client-jar cache across targets ──────────────────────────────
shared_versions="/work/hmc-shared-versions"
mkdir -p "$shared_versions"
if [ ! -L "$cache_dir/versions" ]; then
    rm -rf "$cache_dir/versions" 2>/dev/null || true
    ln -s "$shared_versions" "$cache_dir/versions"
fi

# ── Find the right Java binary ─────────────────────────────────────
java_bin=""
for dir in /usr/lib/jvm/*"${java_version}"*/bin/java; do
    if [ -x "$dir" ]; then
        java_bin="$dir"
        break
    fi
done

if [ -z "$java_bin" ] && command -v java &>/dev/null; then
    java_bin="$(command -v java)"
fi

if [ -z "$java_bin" ] || [ ! -x "$java_bin" ]; then
    echo "ERROR: Java ${java_version} not found" >&2
    echo "Searched /usr/lib/jvm/*${java_version}* and PATH" >&2
    ls -la /usr/lib/jvm/ 2>/dev/null || echo "(no /usr/lib/jvm)" >&2
    exit 1
fi

actual_ver=$("$java_bin" -version 2>&1 | head -1 | sed 's/.*version "\([0-9]*\).*/\1/')
echo "Java: $("$java_bin" -version 2>&1 | head -1) ($java_bin)"
if [ "$actual_ver" != "$java_version" ]; then
    echo "WARNING: Requested Java ${java_version}, using Java ${actual_ver}" >&2
fi

export JAVA_HOME="${java_bin%/bin/java}"
export PATH="$JAVA_HOME/bin:$PATH"

# ── Build JVM arguments ───────────────────────────────────────────
jvmargs="-Dautomodpack.autotest.gamedir=${game_dir} -Dautomodpack.autotest.token=${bridge_token} -Dautomodpack.autotest.render=${render_client} -Dcom.mojang.text2speech=false -Djava.awt.headless=true"
viewport_width=854
if [ "$render_client" = "true" ]; then
    # GUI scale 2 turns this into Minecraft's 320x240 minimum logical canvas.
    viewport_width=640
fi
gameargs="--width ${viewport_width} --height 480"

# ── Write HMC config ──────────────────────────────────────────────
cat > /work/HeadlessMC/config.properties <<EOF
hmc.mcdir=$cache_dir
hmc.gamedir=$game_dir
hmc.offline=true
hmc.offline.username=AutoTest
hmc.auto.download.java=false
hmc.java.versions=$JAVA_HOME/bin/java
hmc.java.require.exact=false
hmc.crash.report.watcher=true
hmc.exit.on.failed.command=true
hmc.check.xvfb=$render_client
hmc.gameargs=$gameargs
EOF

# ── Install loader if needed ──────────────────────────────────────
# Materialise and launch the exact configured loader profile. Launching the generic
# `<loader>:<mc>` target lets HMC pick a different build (for example NeoForge 26.1.0
# for a configured 26.1.2 target), which makes version-specific service tests invalid.
launch_target="${loader}:${minecraft}"
if [ "$prepared_profile" != "true" ] && [ -n "$loader_version" ]; then
    case "$loader" in
        fabric)
            timeout 60 hmc --command "fabric ${minecraft} --uid ${loader_version}"
            launch_target="fabric-loader-${loader_version}-${minecraft}"
            ;;
        forge)
            timeout 180 hmc --command "forge ${minecraft} --uid ${loader_version}"
            launch_target="${minecraft}-forge-${loader_version}"
            ;;
        neoforge)
            timeout 180 hmc --command "neoforge ${minecraft} --uid ${loader_version}"
            launch_target="neoforge-${loader_version}"
            ;;
    esac
fi

# ── Disable Neo/Forge early display window (may cause crash in CI) ──
# Older Forge (≤1.19.2) builds FMLConfig with both autosave() and autoreload().
# If config/fml.toml isn't already spec-correct, FMLConfig.correct() rewrites it
# during early bootstrap; autosave flushes that change to disk and the autoreload
# watcher reloads it on another thread *while* correct() is still iterating the
# config map → ConcurrentModificationException, crashing the client before the
# test bridge comes up. Forge 1.20.1+ and NeoForge dropped autoreload() and are
# not affected. To stay race-free we pre-seed a fully spec-correct fml.toml so
# correct() is skipped entirely (isCorrect() == true). splashscreen=false /
# earlyWindowControl=false keep the headless-unsafe early window disabled.
mkdir -p "$game_dir/config"
fml_toml="$game_dir/config/fml.toml"
case "${loader}:${minecraft}" in
    forge:1.18.2)
        cat > "$fml_toml" <<EOF
versionCheck = true
splashscreen = false
defaultConfigPath = "defaultconfigs"
maxThreads = -1
EOF
        ;;
    forge:1.19.2)
        cat > "$fml_toml" <<EOF
versionCheck = true
splashscreen = false
defaultConfigPath = "defaultconfigs"
disableOptimizedDFU = true
maxThreads = -1
EOF
        ;;
    *)
        # Forge 1.20.1+ / NeoForge: no autoreload(), so correct() can't race.
        cat > "$fml_toml" <<EOF
earlyWindowControl = false
EOF
        ;;
esac

if [ "$prepared_profile" != "true" ]; then
    hmc --command "config -refresh" 2>/dev/null || true
fi

if [ "$prepare_only" = "true" ]; then
    exit 0
fi

# ── Launch ─────────────────────────────────────────────────────────
if [ "$render_client" = "true" ]; then
    display_receipt="$(mktemp)"
    Xvfb -displayfd 3 -screen 0 "${viewport_width}x480x24" +extension GLX +render -noreset 3>"$display_receipt" &
    xvfb_pid=$!
    started=$SECONDS
    while [ ! -s "$display_receipt" ]; do
        if ! kill -0 "$xvfb_pid" 2>/dev/null; then
            wait "$xvfb_pid" || true
            echo "ERROR: Xvfb exited before publishing a display" >&2
            rm -f "$display_receipt"
            exit 1
        fi
        if (( SECONDS - started >= display_start_seconds )); then
            echo "ERROR: Xvfb did not publish a display within ${display_start_seconds}s" >&2
            kill "$xvfb_pid" 2>/dev/null || true
            wait "$xvfb_pid" 2>/dev/null || true
            rm -f "$display_receipt"
            exit 1
        fi
        sleep 0.05
    done
    export DISPLAY=":$(<"$display_receipt")"
    rm -f "$display_receipt"

    hmc --command "launch ${launch_target} -offline --jvm \"${jvmargs}\" ${gameargs}" &
    hmc_pid=$!
    cleanup() {
        kill "$hmc_pid" "$xvfb_pid" 2>/dev/null || true
        wait "$hmc_pid" "$xvfb_pid" 2>/dev/null || true
    }
    trap cleanup EXIT TERM INT
    set +e
    wait "$hmc_pid"
    status=$?
    set -e
    exit "$status"
fi

exec hmc \
  --command "launch ${launch_target} -lwjgl -offline --jvm \"${jvmargs}\" ${gameargs}"
